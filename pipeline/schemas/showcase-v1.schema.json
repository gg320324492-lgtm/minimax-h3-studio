{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "showcase-v1",
  "description": "Scene graph for programmatic product-film / data-showcase video. P3 of docs/UPGRADE_MASTER_PLAN.md. Lives in pipeline/ (Python side) and is mirrored to a zod schema in studio/src/schemas/showcase-v1.ts — the two must stay in sync (see tests/test_showcase_schema_parity.py and tests/test_showcase_schema_mirrors_agree.py).",
  "type": "object",
  "required": [
    "version",
    "project",
    "format",
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "_note": {
      "type": "string",
      "description": "Provenance comment for humans. Declared rather than smuggled through a hole: this is the project's leading-underscore convention for meta/annotation, so it gets a named home instead of riding on additionalProperties. Stripped before rendering — no renderer reads it."
    },
    "style_bible": {
      "$ref": "#/definitions/StyleBible"
    },
    "format": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "description": "`minimum: 16` was HERE, not in zod. zod says `z.number().int().positive()` — the floor is 1. Same rule as camera.perspective: the mirror follows the enforced side.",
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      }
    },
    "bpm": {
      "type": "number",
      "minimum": 40,
      "maximum": 240,
      "default": 126
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Scene"
      }
    }
  },
  "definitions": {
    "Track": {
      "description": "A camera channel: a constant, or [from, to] interpolated over the scene. Mirrors the zod `Track` union. This definition was MISSING until P11 defect 3 — eight properties $ref'd it and nothing provided it, so the whole schema failed to compile in any conforming validator (Ajv: \"can't resolve reference #/definitions/Track from id #\"). Nothing ever noticed because no test ran this file through a validator, only through regexes. A schema that cannot compile cannot disagree with its mirror either: it simply never answers.",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "Scene": {
      "type": "object",
      "required": [
        "id",
        "type",
        "durationInFrames"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "area-chart",
            "bar-chart",
            "browser-stack",
            "browser-window",
            "bubble-chart",
            "calendar",
            "card-grid",
            "dashboard",
            "data-plane-3d",
            "data-table",
            "heatmap",
            "kpi-hero",
            "line-chart",
            "logo",
            "outro",
            "quote",
            "rank-chart",
            "slope-chart",
            "sparkline-chart",
            "stat-card",
            "video",
            "volume-chart"
          ]
        },
        "durationInFrames": {
          "type": "integer",
          "minimum": 1
        },
        "theme": {
          "type": "string"
        },
        "style_bible": {
          "$ref": "#/definitions/StyleBible",
          "description": "Per-scene overrides, merged over the document style_bible AFTER the scene theme is applied."
        },
        "layout": {
          "type": "object"
        },
        "camera": {
          "$ref": "#/definitions/Camera"
        },
        "motion": {
          "$ref": "#/definitions/Motion"
        },
        "content": {
          "type": "object"
        },
        "transitionIn": {
          "$ref": "#/definitions/Transition"
        },
        "transitionOut": {
          "$ref": "#/definitions/Transition"
        },
        "audioEvents": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "Camera": {
      "description": "Camera motion is separate from component motion (P3 design rule). Values are [from, to] pairs in px/deg, or a single number for a constant.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "perspective": {
          "description": "`exclusiveMinimum`, not `minimum`. zod says `z.number().positive()`, so 0 must be REJECTED: a perspective projection divides by it. Measured drift, not a reading — see tests/test_showcase_mirrors_agree_on_values.py.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20000
        },
        "translateX": {
          "$ref": "#/definitions/Track"
        },
        "translateY": {
          "$ref": "#/definitions/Track"
        },
        "translateZ": {
          "$ref": "#/definitions/Track"
        },
        "rotateX": {
          "$ref": "#/definitions/Track"
        },
        "rotateY": {
          "$ref": "#/definitions/Track"
        },
        "rotateZ": {
          "$ref": "#/definitions/Track"
        },
        "scale": {
          "$ref": "#/definitions/Track"
        },
        "focus": {
          "$ref": "#/definitions/Track"
        }
      }
    },
    "Motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "premium",
            "energetic",
            "cinematic",
            "minimal"
          ]
        },
        "stagger": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "Transition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "in": {
          "type": "string"
        },
        "out": {
          "type": "string"
        },
        "durationInFrames": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "StyleBible": {
      "description": "One per project. Every scene must obey it — this is what stops each screen looking like a different template.",
      "type": "object",
      "properties": {
        "palette": {
          "type": "object"
        },
        "typography": {
          "type": "object"
        },
        "spacing": {
          "type": "object"
        },
        "radius": {
          "type": "object"
        },
        "depthCue": {
          "description": "One CSS shadow per depth step, far plane first. All-or-nothing: a partial ramp would mis-index. See docs/STYLE_BIBLE_STRIPPED_SECTIONS.md",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shadow": {
          "type": "object"
        },
        "cameraLanguage": {
          "type": "object"
        },
        "motionLanguage": {
          "type": "object"
        },
        "chartLanguage": {
          "type": "object"
        },
        "audioLanguage": {
          "type": "object"
        }
      }
    }
  }
}
