{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "template": {
      "type": "string",
      "const": "report-vertical"
    },
    "format": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fps": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height",
        "fps"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "badge": {
      "type": "string"
    },
    "accentColor": {
      "default": "#FFD866",
      "type": "string"
    },
    "bpm": {
      "default": 126,
      "type": "number",
      "minimum": 60,
      "maximum": 200
    },
    "sfxAuto": {
      "default": true,
      "type": "boolean"
    },
    "stats": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "delta": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "value"
        ]
      }
    },
    "chart": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "type": {
          "default": "bar",
          "type": "string",
          "enum": [
            "bar",
            "rank"
          ]
        },
        "unit": {
          "type": "string"
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "number",
                "minimum": 0
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "value"
            ]
          }
        }
      },
      "required": [
        "items"
      ]
    },
    "takeaways": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outro": {
      "type": "object",
      "properties": {
        "slogan": {
          "type": "string"
        },
        "sub": {
          "type": "string"
        }
      },
      "required": [
        "slogan"
      ]
    },
    "narration": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "volume": {
          "default": 0.25,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pumpEnvelope": {
          "type": "object",
          "properties": {
            "fps": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "values": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "fps",
            "values"
          ]
        },
        "subtitles": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "text",
              "start",
              "end"
            ]
          }
        }
      },
      "required": [
        "src"
      ]
    }
  },
  "required": [
    "version",
    "project",
    "template",
    "format",
    "title"
  ]
}
